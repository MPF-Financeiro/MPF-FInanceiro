# Banco PRÓPRIO do Financeiro, num projeto Supabase só dele. Nunca o mesmo
# banco do SampsOS: é o que garante que uma migration daqui não possa derrubar
# o sistema da agência.
#
# As duas URLs saem de Project Settings → Database → Connection string, no
# painel do Supabase, e são diferentes de propósito:
#
# DATABASE_URL  Transaction pooler, porta 6543. É a que a aplicação usa em
#               produção, porque na Vercel cada requisição é um processo novo.
#               `pgbouncer=true` é obrigatório: nesse modo o pooler não aceita
#               prepared statements, que é o que o Prisma criaria sozinho.
#               `connection_limit=1` evita estourar o pool em pico.
# DIRECT_URL    Session pooler, porta 5432. Só o Prisma CLI usa, em
#               `db push` e `migrate`, que não funcionam pelo pooler de
#               transação. Prefira o host `...pooler.supabase.com` ao
#               `db.<ref>.supabase.co`: o direto só responde em IPv6.
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
