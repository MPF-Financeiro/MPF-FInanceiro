# Banco PRÓPRIO do Financeiro. Nunca o mesmo do SampsOS: é o que garante que
# uma migration daqui não possa derrubar o sistema da agência.
DATABASE_URL="postgresql://user:pass@host/samps_financeiro?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host/samps_financeiro?sslmode=require"

# openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
